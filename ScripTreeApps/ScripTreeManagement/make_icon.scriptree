{
  "schema_version": 3,
  "name": "ScripTree icon generator",
  "description": "Render the ScripTree fractal-tree app icon.\n\nTwo modes:\n  - Single-shot: fill the Single-shot render fields to write one custom PNG. Nothing else is touched.\n  - Full publish: leave Single-shot fields blank and use the Full publish overrides to re-build scriptree.{png,ico,svg} and icons/icon-forest.{png,svg}.\n\nThe Palette fields (invert + base colour + trunk width) apply to both modes and only affect concept 10.",
  "executable": "python",
  "working_directory": "../../scriptree/resources",
  "argument_template": [
    "make_icon.py",
    [
      "--depth",
      "{depth}"
    ],
    [
      "--size",
      "{size}"
    ],
    [
      "--out",
      "{out}"
    ],
    [
      "--concept",
      "{concept}"
    ],
    [
      "--publish-depth",
      "{publish_depth}"
    ],
    [
      "--ico-sizes",
      "{ico_sizes}"
    ],
    "{invert?--invert}",
    [
      "--color",
      "{color}"
    ],
    [
      "--trunk-width",
      "{trunk_width}"
    ]
  ],
  "params": [
    {
      "id": "depth",
      "label": "Recursion depth (branch iterations)",
      "description": "Single-shot only. How many hex-fractal split levels to draw. Useful range 1-6. Blank = size-adaptive default (1 at 16/24 px, 2 at 32/48, 3 at 64, 4 at 128+).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Single-shot render"
    },
    {
      "id": "size",
      "label": "Output size (pixels, square)",
      "description": "Single-shot only. Width/height of the PNG to write. Blank = script default of 1024.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Single-shot render"
    },
    {
      "id": "out",
      "label": "Output PNG path",
      "description": "Single-shot only. Where to save the PNG. Blank = write next to make_icon.py as scriptree_custom.png.",
      "type": "path",
      "widget": "save_file",
      "required": false,
      "default": "",
      "file_filter": "PNG image (*.png)",
      "section": "Single-shot render"
    },
    {
      "id": "concept",
      "label": "Concept",
      "description": "Which concept to render. Applies to both single-shot and full-publish runs. Blank = active concept (currently 10_grayscale_leveled_tree). Invert/Colour/Trunk width only affect concept 10.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "06_hex_fractal_tree",
        "08_mono_fractal_tree",
        "09_grayscale_fractal_tree",
        "10_grayscale_leveled_tree"
      ],
      "choice_labels": [
        "(active concept)",
        "06 - hex fractal (colour, tiled bg)",
        "08 - mono mint (tiled bg)",
        "09 - grayscale, dark trunk",
        "10 - grayscale leveled (current default)"
      ],
      "section": "Single-shot render"
    },
    {
      "id": "publish_depth",
      "label": "Publish recursion depth (override)",
      "description": "Full-publish only. Forces every ICO frame, the showcase PNG, and the SVG to use this recursion depth, bypassing the size-adaptive ladder. Blank = use the per-size ladder (1 at 16/24, 2 at 32/48, 3 at 64, 4 at 128+). Useful range 1-6.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Full publish overrides"
    },
    {
      "id": "ico_sizes",
      "label": "ICO frame sizes (override)",
      "description": "Full-publish only. Comma-separated pixel sizes for the .ico frames, e.g. \"16,32,48,256\". Each entry must be 8..1024 px. Blank = default ladder 16,24,32,48,64,128,256.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Full publish overrides"
    },
    {
      "id": "invert",
      "label": "Invert palette (light trunk -> dark tips)",
      "description": "Flips the brightness ladder so the trunk + nearest branches are LIGHTEST and the canopy tips are DARKEST. Pair with no Base colour for a light-on-dark icon; pair with a Base colour for inverted tints of that hue. Concept 10 only.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Palette"
    },
    {
      "id": "color",
      "label": "Base colour (hex, blank = grayscale)",
      "description": "Re-map the grayscale brightness ladder onto a chosen hue. Format: #RRGGBB or RRGGBB; #RGB shorthand accepted. The trunk-darker / tips-lighter (or inverted) relationship becomes shades-then-tints of this colour. Examples: #56D6A8 = ScripTree mint, #3B82F6 = blue. Blank keeps the icon grayscale. Concept 10 only.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Palette"
    },
    {
      "id": "trunk_width",
      "label": "Trunk width (pixels at 1024 canvas)",
      "description": "Override the trunk stroke thickness. Value is in pixels at the 1024-reference canvas and scales proportionally for other canvases (so 50 means 50 px at 1024, ~12 px at 256, ~3 px at 64). Only the trunk is affected; canopy branches keep their fractal-derived weights. Blank = use the fractal default (~40 px at 1024). Concept 10 only.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Palette"
    }
  ],
  "sections": [
    {
      "name": "Single-shot render",
      "layout": "collapse",
      "collapsed": false
    },
    {
      "name": "Full publish overrides",
      "layout": "collapse",
      "collapsed": true
    },
    {
      "name": "Palette",
      "layout": "collapse",
      "collapsed": true
    }
  ],
  "env": {},
  "path_prepend": [],
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "source": {
    "mode": "manual",
    "help_text_cached": null
  }
}