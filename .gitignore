__pycache__/
*.pyc
*.pyo
.pytest_cache/
.vscode/
.idea/
*.zip
*.bak
*.bak-*
*.log
*.tmp

# Vendored / portable Python and pinned wheels are COMMITTED to the
# repo (v0.3.10+) so a fresh ``git clone`` Just Works on a clean
# machine — no system Python, no internet, no ``pip install`` step.
# Total cost: ~93 MB (Python embed + PySide6 wheels), regeneratable
# by ``lib/install_python.ps1`` and ``lib/update_lib.py --trim``
# whenever the bundled versions need to roll forward.
#
# We still ignore compiled bytecode under those trees — it gets
# regenerated on first run and doesn't round-trip cleanly through
# git (mtime-sensitive, OS-specific paths in some headers).
lib/python/**/__pycache__/
lib/pypi/**/__pycache__/

# combridge is a SEPARATE project (KenM76/combridge) with its own
# repo and release cycle.  We bundle its built binaries into
# lib/combridge/ at portable-build time via lib/install_combridge.ps1,
# but the source-controlled markers (.gitkeep + README.md) are
# tracked.  Everything else in that directory is a build artefact
# from the other project and should never be committed here.
lib/combridge/*
!lib/combridge/.gitkeep
!lib/combridge/README.md

# Per-user state
*.configs.json
*.treeconfigs.json
user_configs/
# ``scriptree.ini`` holds machine-specific window geometry, dock-state
# byte-arrays, and a per-user recent-files list (absolute local paths).
# It was tracked in error through v0.8.0a88; a116 untracks it (git rm
# --cached) and ignores it here so it never re-enters the public repo.
# The app regenerates it on first run from QSettings defaults.
scriptree.ini
scriptree.ini.bak

# Concept art / design explorations (fractal-tree icon studies) live
# under scriptree/resources/concepts/.  They are working design assets,
# not shipped runtime resources, and are excluded from the repo per the
# project's never-commit list.
scriptree/resources/concepts/

# OneDrive cruft
desktop.ini
# Ignore .claude/ generally (session metadata, worktrees, settings) but
# track the project-specific agent definition so future sessions inherit
# the working style captured during the V3 build-out.
.claude/*
!.claude/agents/
!.claude/agents/**
Untitled tree.scriptreetree
